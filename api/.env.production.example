#--------------------------------------------------------------------
# Marooff backend API — PRODUCTION environment
#
# To deploy:
#   1. Rename this file to `.env` (or copy and rename)
#   2. Replace every <ANGLE-BRACKET> placeholder with your real values
#   3. Upload to /home/u823898062/domains/marooffc.com/public_html/api/.env
#   4. Make sure the file is NOT world-readable (chmod 644 is fine)
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://api.marooffc.com/'
app.forceGlobalSecureRequests = true
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE — fill from Hostinger hPanel → Databases → MySQL Databases
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = <YOUR_HOSTINGER_DB_NAME>
database.default.username = <YOUR_HOSTINGER_DB_USER>
database.default.password = <YOUR_HOSTINGER_DB_PASSWORD>
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# ENCRYPTION — generate one fresh 32-byte base64 string for production.
# Easiest: openssl rand -base64 32   (or use any online base64 generator)
#--------------------------------------------------------------------
encryption.key = base64:<GENERATE_RANDOM_32_BYTES_BASE64>

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------
session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.cookieName = ci_session
session.expiration = 7200
session.savePath = null

#--------------------------------------------------------------------
# AUTH — JWT signing secret. MUST be random, long, never reused across sites.
# Generate with: openssl rand -hex 32     (or any random 64+ hex chars)
#--------------------------------------------------------------------
auth.jwt_secret = <GENERATE_64_HEX_CHARS>
auth.jwt_access_ttl  = 28800     # 8 hours
auth.jwt_refresh_ttl = 2592000   # 30 days

#--------------------------------------------------------------------
# CORS — list the front-end origins that may call the API
#--------------------------------------------------------------------
cors.allowed_origins = 'https://marooffc.com,https://www.marooffc.com,https://admin.marooffc.com'

#--------------------------------------------------------------------
# UPLOADS — serve user-uploaded files via the API subdomain
#--------------------------------------------------------------------
upload.driver = local
upload.public_url = 'https://api.marooffc.com/uploads/'

#--------------------------------------------------------------------
# STRIPE — LIVE production keys
#
# BEFORE LAUNCH:
#   - The keys exposed in our chat have been rotated (client did this in Stripe Dashboard).
#   - Paste the brand-new `sk_live_*` here. Publishable key is also re-issued.
#--------------------------------------------------------------------
stripe.publishable_key = <NEW_pk_live_KEY_FROM_STRIPE>
stripe.secret_key      = <NEW_sk_live_KEY_FROM_STRIPE>

# Webhook signing secret — created in Stripe Dashboard → Developers → Webhooks
# Endpoint URL to register:   https://api.marooffc.com/api/webhooks/stripe
# Events to subscribe:         payment_intent.succeeded,
#                              payment_intent.payment_failed,
#                              payment_intent.canceled
# Stripe will reveal the `whsec_*` once. Paste it here.
stripe.webhook_secret  = <whsec_FROM_STRIPE_AFTER_WEBHOOK_CREATED>

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------
logger.threshold = 4
