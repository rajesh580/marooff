# ============================================================
#   Maroof Storefront — Apache / LiteSpeed Configuration
# ============================================================

# Disable directory browsing
Options -Indexes +FollowSymLinks

# Custom 404 error page using Next.js branded 404
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  CGIPassAuth On

  # Pass Authorization header to PHP / backends
  SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # Rewrite root /uploads/ to CodeIgniter public uploads folder
  RewriteRule ^uploads/(.*)$ api/public/uploads/$1 [L]

  # Skip if the requested file or directory exists on disk
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Dynamic route fallbacks for Next.js `output: 'export'`
  # When new products/categories/combos are added in admin, fallback to the shell:
  RewriteRule ^combos/([^/]+)/?$ /combos/_/index.html [L]
  RewriteRule ^product/([^/]+)/?$ /product/_/index.html [L]
  RewriteRule ^category/([^/]+)/?$ /category/_/index.html [L]
</IfModule>

# MIME types
<IfModule mod_mime.c>
  AddType application/font-woff2 .woff2
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/json .json
</IfModule>

# Performance: Caching Headers
<IfModule mod_headers.c>
  # Fingerprinted Next.js static chunks & fonts: 1 year immutable cache
  <FilesMatch "\.(js|mjs|css|woff2|woff|ttf|eot|svg|png|jpe?g|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML pages & text manifests: no-cache to always get fresh data
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Security Headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
